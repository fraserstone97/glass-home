<?xml version="1.0" encoding="utf-8"?>
<!-- A page closing: it fades away over the page beneath in the same 300 ms linear crossfade. -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/linear_interpolator"
    android:fromAlpha="1" android:toAlpha="0" android:duration="300" />
