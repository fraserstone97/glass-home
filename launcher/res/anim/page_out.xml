<?xml version="1.0" encoding="utf-8"?>
<!-- A page closing: it fades as it grows a little, back towards you, revealing what's beneath. -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/ease" android:shareInterpolator="true">
    <alpha android:fromAlpha="1" android:toAlpha="0" android:duration="220" />
    <scale android:fromXScale="1" android:toXScale="1.03" android:fromYScale="1" android:toYScale="1.03"
        android:pivotX="50%" android:pivotY="50%" android:duration="260" />
</set>
