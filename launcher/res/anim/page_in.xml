<?xml version="1.0" encoding="utf-8"?>
<!-- A page opening: it fades in over the page beneath, which stays still, as the Apple TV app
     does (a plain 300 ms linear crossfade, no scale). -->
<alpha xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:anim/linear_interpolator"
    android:fromAlpha="0" android:toAlpha="1" android:duration="300" />
