<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="app.glasshome.launcher">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Uninstall, from an app's menu on Home (Android's own screen asks first). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Search: dictation from the remote's mic, through a speech recogniser that isn't the Gemini app. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Settings > Screen Saver (the TV's own screen saver and turn-off settings), and the
         remote-buttons helper put back on after a force stop switched it off (granted over adb). -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Home's network status and Control Centre's Wi-Fi name (Android only gives it with location). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Android 12+ shows no prompt for fine location asked for without coarse. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Sleep Timer: an exact alarm, so the TV turns off on the minute, not when Android gets round to it. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" android:maxSdkVersion="32" />
    <!-- App Switcher: the apps used most recently (granted over adb, or in Settings > Usage access). -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <!-- Every screen saver on the TV, for Settings > Screen Saver. -->
        <intent>
            <action android:name="android.service.dreams.DreamService" />
        </intent>
        <!-- The screen saver now, for Back on the first app and Control Centre's Screen Saver button:
             Android's "start screen saver" (Somnambulator), or Glass Aerials when the TV can't. -->
        <package android:name="app.glasshome.aerials" />
        <package android:name="com.android.systemui" />
    </queries>

    <application
        android:label="@string/app_name"
        android:icon="@drawable/ic_launcher"
        android:banner="@drawable/banner"
        android:theme="@style/HomeTheme"
        android:allowBackup="false">
        <!-- Lets developer tools (simpleperf, Android Studio) sample it from adb; no effect otherwise. -->
        <profileable android:shell="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Control Centre: Turn Off / Sleep Timer (force-lock device admin only). -->
        <receiver
            android:name=".SleepReceiver$Admin"
            android:exported="true"
            android:label="@string/label_sleep"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data android:name="android.app.device_admin" android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>
        <receiver android:name=".SleepReceiver" android:exported="false" />
        <service
            android:name=".PowerService"
            android:exported="true"
            android:label="@string/label_power"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/power_service" />
        </service>

        <!-- Remote buttons only the stock Google TV home answered (Netflix, Prime Video, YouTube, Quick
             Settings), hold-to-talk on the mic, and Home pressed twice for the App Switcher. -->
        <service
            android:name=".KeysService"
            android:exported="true"
            android:label="@string/label_keys"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/keys_service" />
        </service>

        <!-- Now Playing in Control Centre: media sessions are only shared with a notification listener. -->
        <service
            android:name=".MediaListener"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Control Centre: from Home's button, and over the current app from the remote's Quick
             Settings button (KeysService). -->
        <activity
            android:name=".ControlCentreActivity"
            android:exported="false"
            android:theme="@style/OverlayTheme"
            android:launchMode="singleTask"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density" />

        <!-- A title page's trailer, played full screen; in a process of its own, so the web engine
             it plays in never stays in Home's. -->
        <activity
            android:name=".TrailerActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:process=":trailer"
            android:screenOrientation="landscape"
            android:theme="@style/PageTheme"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density" />

        <!-- A show or film's page, opened from Search. -->
        <activity
            android:name=".DetailActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:theme="@style/PageTheme"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density" />

        <!-- Search: the remote's mic button (KeysService), or as the TV's assistant when the helper is off. -->
        <activity
            android:name=".SearchActivity"
            android:theme="@style/OverlayTheme"
            android:exported="true"
            android:launchMode="singleTask"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:windowSoftInputMode="adjustNothing"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <action android:name="android.intent.action.VOICE_ASSIST" />
                <action android:name="android.intent.action.SEARCH_LONG_PRESS" />
                <action android:name="android.speech.action.VOICE_SEARCH_HANDS_FREE" />
                <action android:name="android.search.action.GLOBAL_SEARCH" />
                <action android:name="android.intent.action.WEB_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- The Guide: what's on (Freely's London listings), each channel opened in its own app. An app
             of its own on the TV (one of it, in its own task, like any app), and a card on Home. -->
        <activity
            android:name=".GuideActivity"
            android:label="@string/guide_name"
            android:launchMode="singleTask"
            android:taskAffinity="app.glasshome.launcher.guide"
            android:banner="@drawable/guide_banner"
            android:theme="@style/PageTheme"
            android:exported="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- First-run setup (and Settings > Home Screen > Run Setup Again): opens and closes like the other pages. -->
        <activity
            android:name=".SetupActivity"
            android:theme="@style/PageTheme"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density" />
        <activity
            android:name=".SettingsActivity"
            android:theme="@style/PageTheme"
            android:exported="true"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|smallestScreenSize|screenLayout|uiMode|density" />
    </application>
</manifest>
